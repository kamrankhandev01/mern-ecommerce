{
  "$schema": "https://vercel.sh",
  "services": {
    "web": {
      "root": "client",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "server",
      "entrypoint": "app.js",
      "functions": {
        "**/*.js": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
