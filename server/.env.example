# ---------------------------------------------------------------------------
# This flag line is replaced by the real values below in .env
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/astra

# Session signing secret — use a long random string in production
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser origins allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# Behind a reverse proxy (Render, Railway, Nginx) set this to true
TRUST_PROXY=false

# Shared secret for scheduled jobs. Vercel Cron sends it as a bearer token, so
# the /api/orders/cron/release-expired route stays private. Optional outside
# serverless hosting, where the in-process sweeper does the same job.
CRON_SECRET=

# Store rules
STORE_CURRENCY=USD
FREE_SHIPPING_THRESHOLD=75
FLAT_SHIPPING_RATE=8
MAX_UPLOAD_BYTES=5242880
CHECKOUT_WINDOW_MINUTES=32

# Outbound email (Brevo / any SMTP relay). Optional outside development.
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=

# Image storage (Cloudinary). Optional — product/profile uploads need it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (test keys are fine). Card checkout is enabled only when BOTH are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Safepay. Checkout is enabled only when all three values are set.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PUBLISH_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_CURRENCY=USD
