# Base URL of the API. Leave unset in development to use http://localhost:3000
VITE_API_URL=http://localhost:3000

# Optional: serve the app on the same origin as the API during development by
# running `npm run dev` with VITE_API_PROXY=true and VITE_DEV_PROXY set.
# VITE_API_PROXY=true
# VITE_DEV_PROXY=http://localhost:3000
