# Files that must never reach the build. Vercel uploads this directory, and a
# stray `server/.env` would otherwise ship real secrets inside the bundle.

# Dependencies are installed on Vercel from package-lock.json, not uploaded.
node_modules
**/node_modules

# Local build output; Vercel runs the build itself.
client/dist

# Secrets live in the Vercel project's environment variables, not in the repo.
.env
**/.env
**/.env.*

# Vercel internals, VCS metadata and editor cruft.
.vercel
.git
.github
.vscode
.idea
*.log

# Local scratch output.
client/lint-client.txt
