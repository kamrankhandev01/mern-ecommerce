# Base URL of the API.
#
# Leave this unset in development to use http://localhost:3000. In production
# the same deployment serves the SPA and the API on one domain, so leave it
# unset (or empty) there to send same-origin requests to /api/... — set it only
# when the client is hosted separately from the API.
VITE_API_URL=http://localhost:3000

# Optional: serve the app on the same origin as the API during development by
# running `npm run dev` with VITE_API_PROXY=true and VITE_DEV_PROXY set.
# VITE_API_PROXY=true
# VITE_DEV_PROXY=http://localhost:3000
